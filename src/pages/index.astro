---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import PracticeAreas from "../components/PracticeAreas.astro";
import { SITE } from "../config/site";
---

<Base
  title="עורך דין משפט פלילי, צווארון לבן ודיני צבא וביטחון | ליאור עייש"
  description='עו"ד ליאור עייש, לשעבר סגן התובע הצבאי הראשי: משרד בוטיק לייצוג בהליכים משפטיים מורכבים - משפט פלילי, עבירות צווארון לבן ודיני צבא וביטחון. צרו קשר לייעוץ.'
  path="/"
  preloadImages={[{ href: "/images/lior-home.webp" }]}
>
  <!-- ===== Hero: כותרת + תמונה של ליאור + תיבת פניות ===== -->
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">ליאור עייש - משרד עורכי דין</p>
        <h1>משפט פלילי, צווארון לבן, דיני צבא וביטחון</h1>
        <p class="lead">
          משרד בוטיק המתמחה בייצוג בהליכים משפטיים מורכבים, בניהול אסטרטגיה
          משפטית וניהול משברים.
        </p>
        <div class="hero-phone">
          <a href={`tel:${SITE.phoneIntl}`} class="btn btn--outline">
            חייגו עכשיו: <bdo dir="ltr">{SITE.phone}</bdo>
          </a>
        </div>
      </div>

      <div class="hero-photo">
        <img
          src="/images/lior-home.webp"
          alt='עו"ד ליאור עייש - משרד עורכי דין'
          width="820"
          height="1230"
          fetchpriority="high"
        />
      </div>

      <div class="hero-form">
        <LeadForm />
      </div>
    </div>
  </section>

  <!-- ===== רצועת נתונים - אמון במספרים ===== -->
  <section class="stats" aria-label="נתוני המשרד">
    <div class="container stats-grid">
      <div class="stat">
        <span class="stat-num">14+</span>
        <span class="stat-label">שנות ניסיון במשפט הפלילי והצבאי</span>
      </div>
      <div class="stat">
        <span class="stat-num">סא"ל</span>
        <span class="stat-label">לשעבר סגן התובע הצבאי הראשי</span>
      </div>
      <div class="stat">
        <span class="stat-num">100%</span>
        <span class="stat-label">ליווי אישי מהפנייה ועד ההצלחה</span>
      </div>
    </div>
  </section>

  <!-- ===== תחומי ההתמחות ===== -->
  <PracticeAreas />
</Base>

<style>
  /* ===== Hero - כותרת + תמונה + טופס ===== */
  .home-hero {
    background: linear-gradient(155deg, var(--navy-900) 0%, var(--navy-800) 60%, #063362 100%);
    color: #dce4ee;
    position: relative;
    overflow: hidden;
    /* ריפוד עליון מוגדל - ההדר השקוף מרחף מעל ההירו */
    padding-block: calc(clamp(2.5rem, 6vw, 4.5rem) + 4.6rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-areas: "copy photo" "form photo";
    column-gap: clamp(1.5rem, 3.5vw, 3rem);
    row-gap: 1.6rem;
    align-items: start;
  }

  .hero-copy {
    grid-area: copy;
  }

  .hero-form {
    grid-area: form;
  }

  .hero-photo {
    grid-area: photo;
    align-self: stretch;
    position: relative;
    min-height: 100%;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    display: block;
    border-radius: 16px;
    border: 1px solid rgba(199, 176, 147, 0.35);
    box-shadow: 0 22px 55px rgba(0, 8, 20, 0.45);
  }

  .eyebrow {
    color: var(--gold-400);
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 0.6em;
  }

  .home-hero h1 {
    color: var(--white);
  }

  .lead {
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    color: #c9d4e2;
    margin-bottom: 1.5em;
    line-height: 1.7;
  }

  .home-hero .btn--outline {
    border-color: var(--gold-400);
    color: var(--gold-400);
  }

  .home-hero .btn--outline:hover {
    background: var(--gold-400);
    color: var(--navy-900);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-areas: "copy" "photo" "form";
    }

    .hero-photo {
      align-self: auto;
      max-width: 440px;
      margin-inline: auto;
      width: 100%;
    }

    .hero-photo img {
      height: 420px;
      object-position: 50% 10%;
    }
  }

  /* ===== רצועת נתונים ===== */
  .stats {
    background: var(--gold-100);
    border-bottom: 1px solid var(--line);
    padding-block: 1.6rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    text-align: center;
  }

  .stat-num {
    display: block;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    color: var(--navy-800);
    line-height: 1.2;
  }

  .stat-label {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 700px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
  }
</style>
