---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import { SITE } from "../config/site";

// אייקוני זהב לכרטיסי תחומי ההתמחות
const icons: Record<string, string> = {
  homicide: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3l7 7M17.5 6.5l-11 11M5 14l5 5M3 21l3.5-3.5M10.5 10.5l3 3"/></svg>`,
  sex: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-8-4.6-8-11a4 4 0 0 1 8-1 4 4 0 0 1 8 1c0 6.4-8 11-8 11z"/><path d="M9.5 11.5l1.7 1.7 3.3-3.3"/></svg>`,
  weapons: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v5c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6l8-3z"/><path d="M9.5 9.5l5 5M14.5 9.5l-5 5"/></svg>`,
  whitecollar: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18M12 12v3"/></svg>`,
  criminal: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M4 21V10M20 21V10M8 21v-7M12 21v-7M16 21v-7M2 10h20L12 3 2 10z"/></svg>`,
  military: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4l7 4 7-4M5 10l7 4 7-4M5 16l7 4 7-4"/></svg>`,
  status: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="11" r="2"/><path d="M5.5 16a3 3 0 0 1 6 0M14 10h4M14 13.5h3"/></svg>`,
  ptsd: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.6-9.3-9A5.4 5.4 0 0 1 12 6.3 5.4 5.4 0 0 1 21.3 12C19 16.4 12 21 12 21z"/><path d="M5 12h4l1.5-3 3 6L15 12h4"/></svg>`,
  mod: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v5c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6l8-3z"/><path d="M12 8v8M8 12h8"/></svg>`,
};

// תחומי ההתמחות בעמוד הבית - לפי הסדר שנקבע
const HOME_SERVICES = [
  { title: "עבירות המתה ורשלנות", short: "ייצוג בעבירות רצח, הריגה וגרימת מוות ברשלנות", href: "/criminal-law/", icon: "homicide" },
  { title: "עבירות מין חמורות", short: "עבירות מין חמורות ועבירות לפי החוק למניעת הטרדה מינית", href: "/criminal-law/", icon: "sex" },
  { title: "עבירות בנשק", short: "החזקה, סחר וירי - ייצוג בעבירות נשק", href: "/criminal-law/", icon: "weapons" },
  { title: "צווארון לבן", short: "מרמה, עבירות מס, הלבנת הון ועבירות ניירות ערך", href: "/white-collar/", icon: "whitecollar" },
  { title: "משפט פלילי", short: "ייצוג בכל סוגי העבירות הפליליות", href: "/criminal-law/", icon: "criminal" },
  { title: "דיני צבא וביטחון", short: 'ייעוץ בחקירות מצ"ח וייצוג בפני בתי דין צבאיים', href: "/military-law/", icon: "military" },
  { title: 'הסדרת מעמד מול צה"ל', short: "אזרחים יורדים, בני מהגרים וספורטאים מצטיינים", href: "/military-service-status/", icon: "status" },
  { title: "הכרה בפוסט טראומה", short: "תביעה להכרה בפוסט טראומה בעקבות השירות הצבאי", href: "/ptsd-lawyer/", icon: "ptsd" },
  { title: "תביעות נגד משרד הביטחון", short: "הכרה בנכות, החמרת מצב ותגמולים לחיילים ואנשי כוחות הביטחון", href: "/mod-claims/", icon: "mod" },
];
---

<Base
  title="עורך דין משפט פלילי, צווארון לבן ודיני צבא וביטחון | ליאור עייש"
  description='עו"ד ליאור עייש, לשעבר סגן התובע הצבאי הראשי: משרד בוטיק לייצוג בהליכים משפטיים מורכבים - משפט פלילי, עבירות צווארון לבן ודיני צבא וביטחון. צרו קשר לייעוץ.'
  path="/"
>
  <!-- ===== Hero: כותרת + תיבת פניות על רקע נקי ===== -->
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">ליאור עייש - משרד עורכי דין</p>
        <h1>משפט פלילי, צווארון לבן, דיני צבא וביטחון</h1>
        <p class="lead">
          משרד בוטיק המתמחה בייצוג בהליכים משפטיים מורכבים, בניהול אסטרטגיה
          משפטית וניהול משברים.
        </p>
        <div class="hero-phone">
          <a href={`tel:${SITE.phoneIntl}`} class="btn btn--outline">
            או חייגו עכשיו: <bdo dir="ltr">{SITE.phone}</bdo>
          </a>
        </div>
      </div>
      <div class="hero-form">
        <LeadForm />
      </div>
    </div>
  </section>

  <!-- ===== רצועת נתונים - אמון במספרים ===== -->
  <section class="stats" aria-label="נתוני המשרד">
    <div class="container stats-grid">
      <div class="stat">
        <span class="stat-num">14+</span>
        <span class="stat-label">שנות ניסיון במשפט הפלילי והצבאי</span>
      </div>
      <div class="stat">
        <span class="stat-num">סא"ל</span>
        <span class="stat-label">לשעבר סגן התובע הצבאי הראשי</span>
      </div>
      <div class="stat">
        <span class="stat-num">100%</span>
        <span class="stat-label">ליווי אישי מהפנייה ועד ההצלחה</span>
      </div>
    </div>
  </section>

  <!-- ===== תחומי ההתמחות ===== -->
  <section class="section services-dark" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title">תחומי ההתמחות שלנו</h2>
      <div class="grid grid--3">
        {
          HOME_SERVICES.map((s) => (
            <a class="dark-card" href={s.href}>
              <span class="dark-card-icon" set:html={icons[s.icon]} />
              <h3>{s.title}</h3>
              <p>{s.short}</p>
              <span class="more">למידע נוסף ←</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== Hero - רקע נקי בגווני המותג ===== */
  .home-hero {
    background: linear-gradient(155deg, var(--navy-900) 0%, var(--navy-800) 60%, #063362 100%);
    color: #dce4ee;
    position: relative;
    overflow: hidden;
    /* ריפוד עליון מוגדל - ההדר השקוף מרחף מעל ההירו */
    padding-block: calc(clamp(3rem, 7vw, 5.5rem) + 4.8rem) clamp(3rem, 7vw, 5.5rem);
  }

  /* מונוגרמת המותג כסימן מים עדין */
  .home-hero::after {
    content: "";
    position: absolute;
    inset-block: -12%;
    inset-inline-end: -3%;
    width: min(38vw, 460px);
    background: url("/images/logo-horizontal-white.png") no-repeat center / contain;
    opacity: 0.05;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    position: relative;
  }

  .eyebrow {
    color: var(--gold-400);
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 0.6em;
  }

  .home-hero h1 {
    color: var(--white);
    max-width: 46rem;
  }

  .lead {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    max-width: 40rem;
    color: #c9d4e2;
    margin-bottom: 1.6em;
    line-height: 1.7;
  }

  .home-hero .btn--outline {
    border-color: var(--gold-400);
    color: var(--gold-400);
  }

  .home-hero .btn--outline:hover {
    background: var(--gold-400);
    color: var(--navy-900);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ===== רצועת נתונים ===== */
  .stats {
    background: var(--gold-100);
    border-bottom: 1px solid var(--line);
    padding-block: 1.6rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    text-align: center;
  }

  .stat-num {
    display: block;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    color: var(--navy-800);
    line-height: 1.2;
  }

  .stat-label {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 700px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
  }

  /* ===== תחומי ההתמחות - כרטיסים כהים ===== */
  .services-dark {
    background: linear-gradient(165deg, var(--navy-900) 0%, var(--navy-800) 100%);
  }

  .services-dark h2 {
    color: var(--white);
    text-align: center;
    margin-bottom: 1.6rem;
  }

  .dark-card {
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(174, 148, 117, 0.45);
    border-radius: var(--radius);
    padding: 1.7rem 1.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .dark-card:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.09);
    border-color: var(--gold-400);
  }

  .dark-card-icon {
    width: 62px;
    height: 62px;
    color: var(--gold-400);
    margin-bottom: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(174, 148, 117, 0.14);
    border: 1px solid rgba(174, 148, 117, 0.35);
    transition: transform 0.2s ease;
  }

  .dark-card-icon :global(svg) {
    width: 30px;
    height: 30px;
  }

  .dark-card:hover .dark-card-icon {
    transform: translateY(-4px);
  }

  .dark-card h3 {
    color: var(--white);
    font-size: 1.2rem;
    margin-bottom: 0.45em;
  }

  .dark-card p {
    color: #b9c6d6;
    font-size: 0.98rem;
    margin-bottom: 1em;
    flex-grow: 1;
  }

  .dark-card .more {
    color: var(--gold-400);
    font-weight: 600;
  }

  .dark-card:hover .more {
    text-decoration: underline;
  }
</style>
