---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import PracticeAreas from "../components/PracticeAreas.astro";
import { SITE } from "../config/site";
---

<Base
  title="עורך דין משפט פלילי, צווארון לבן ודיני צבא וביטחון | ליאור עייש"
  description='עו"ד ליאור עייש, לשעבר סגן התובע הצבאי הראשי: משרד בוטיק לייצוג בהליכים משפטיים מורכבים - משפט פלילי, עבירות צווארון לבן ודיני צבא וביטחון. צרו קשר לייעוץ.'
  path="/"
>
  <!-- ===== Hero: כותרת + תיבת פניות על רקע נקי ===== -->
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">ליאור עייש - משרד עורכי דין</p>
        <h1>משפט פלילי, צווארון לבן, דיני צבא וביטחון</h1>
        <p class="lead">
          משרד בוטיק המתמחה בייצוג בהליכים משפטיים מורכבים, בניהול אסטרטגיה
          משפטית וניהול משברים
        </p>
        <div class="hero-phone">
          <a href={`tel:${SITE.phoneIntl}`} class="btn btn--outline">
            חייגו עכשיו: <bdo dir="ltr">{SITE.phone}</bdo>
          </a>
        </div>
      </div>
      <div class="hero-form">
        <LeadForm />
      </div>
    </div>
  </section>

  <!-- ===== רצועת נתונים - אמון במספרים ===== -->
  <section class="stats" aria-label="נתוני המשרד">
    <div class="container stats-grid">
      <div class="stat">
        <span class="stat-num">14+</span>
        <span class="stat-label">שנות ניסיון במשפט הפלילי והצבאי</span>
      </div>
      <div class="stat">
        <span class="stat-num">סא"ל</span>
        <span class="stat-label">לשעבר סגן התובע הצבאי הראשי</span>
      </div>
      <div class="stat">
        <span class="stat-num">100%</span>
        <span class="stat-label">ליווי אישי מהפנייה ועד ההצלחה</span>
      </div>
    </div>
  </section>

  <!-- ===== תחומי ההתמחות ===== -->
  <PracticeAreas />

  <!-- ===== הכירו את עו"ד עייש ===== -->
  <section class="section attorney" aria-labelledby="attorney-title">
    <div class="container attorney-grid">
      <div class="attorney-photo">
        <img
          src="/images/lior-home.webp"
          alt='עו"ד ליאור עייש - משרד עורכי דין'
          width="820"
          height="1230"
          loading="lazy"
        />
      </div>
      <div class="attorney-text">
        <p class="eyebrow-sm">הכירו אותנו</p>
        <h2 id="attorney-title">עו"ד ליאור עייש</h2>
        <p>
          לשעבר סגן התובע הצבאי הראשי בדרגת סגן אלוף, עם למעלה מ-14 שנות ניסיון
          משני צידי המתרס - כתובע בכיר וכסנגור. המשרד מתמחה בליטיגציה מורכבת,
          בניהול אסטרטגיה משפטית ובניהול משברים ברגעים המכריעים ביותר.
        </p>
        <div class="attorney-cta">
          <a href="/about/" class="btn btn--primary">אודות המשרד</a>
          <a href="/contact/" class="btn btn--outline">צרו קשר</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== Hero - רקע נקי בגווני המותג ===== */
  .home-hero {
    background: linear-gradient(155deg, var(--navy-900) 0%, var(--navy-800) 60%, #063362 100%);
    color: #dce4ee;
    position: relative;
    overflow: hidden;
    /* ריפוד עליון מוגדל - ההדר השקוף מרחף מעל ההירו */
    padding-block: calc(clamp(3rem, 7vw, 5.5rem) + 4.8rem) clamp(3rem, 7vw, 5.5rem);
  }

  /* מונוגרמת המותג כסימן מים עדין */
  .home-hero::after {
    content: "";
    position: absolute;
    inset-block: -12%;
    inset-inline-end: -3%;
    width: min(38vw, 460px);
    background: url("/images/logo-horizontal-white.png") no-repeat center / contain;
    opacity: 0.05;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    position: relative;
  }

  .eyebrow {
    color: var(--gold-400);
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 0.6em;
  }

  .home-hero h1 {
    color: var(--white);
    max-width: 46rem;
  }

  .lead {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    max-width: 40rem;
    color: #c9d4e2;
    margin-bottom: 1.6em;
    line-height: 1.7;
  }

  .home-hero .btn--outline {
    border-color: var(--gold-400);
    color: var(--gold-400);
  }

  .home-hero .btn--outline:hover {
    background: var(--gold-400);
    color: var(--navy-900);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ===== רצועת נתונים ===== */
  .stats {
    background: var(--gold-100);
    border-bottom: 1px solid var(--line);
    padding-block: 1.6rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    text-align: center;
  }

  .stat-num {
    display: block;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    color: var(--navy-800);
    line-height: 1.2;
  }

  .stat-label {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 700px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
  }

  /* ===== רצועת הכירו את עו"ד עייש ===== */
  .attorney {
    background: var(--gold-100);
  }

  .attorney-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(1.5rem, 4vw, 3.2rem);
    align-items: center;
  }

  .attorney-photo {
    position: relative;
  }

  /* מסגרת זהב מוזחת - מוטיב מהמיתוג */
  .attorney-photo::before {
    content: "";
    position: absolute;
    inset: 16px 16px -16px -16px;
    border: 1px solid var(--gold-500);
    border-radius: var(--radius);
    pointer-events: none;
  }

  .attorney-photo img {
    position: relative;
    width: 100%;
    display: block;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
  }

  .attorney-text h2 {
    margin-top: 0;
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
  }

  .attorney-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
  }

  @media (max-width: 760px) {
    .attorney-grid {
      grid-template-columns: 1fr;
    }

    .attorney-photo {
      max-width: 340px;
      margin-inline: auto;
    }

    .attorney-photo::before {
      inset: 11px 11px -11px -11px;
    }
  }
</style>
