---
import ServicePage from "../layouts/ServicePage.astro";

const faq = [
  {
    q: `מהי מח"ש ואת מי היא חוקרת?`,
    a: `מח"ש - המחלקה לחקירות שוטרים בפרקליטות - היא הגוף המוסמך לחקור חשדות לעבירות שביצעו שוטרים ואנשי כוחות הביטחון במהלך תפקידם, ובכלל זה אירועי שימוש בכוח וירי. חקירת מח"ש היא חקירה פלילית לכל דבר, ותוצאותיה עלולות להוביל לכתב אישום, להליך משמעתי ולפגיעה בקריירה - ולכן חשוב להיערך אליה נכון.`,
  },
  {
    q: `זומנתי לחקירת מח"ש בעקבות אירוע מבצעי. האם להתייעץ עם עורך דין?`,
    a: `בהחלט, ולפני החקירה. גם כאשר פעלתם לפי הנהלים והוראות הפתיחה באש, אופן הצגת הדברים בחקירה הוא קריטי. יש לכם זכות מלאה להיוועץ בעורך דין, וייעוץ מוקדם - על ידי מי שמכיר את הדין המבצעי ואת כללי הפעלת הכוח - יכול לקבוע את גורל התיק.`,
  },
  {
    q: `פעלתי לפי הוראות הפתיחה באש. האם זו הגנה?`,
    a: `פעולה במסגרת הסמכות ובהתאם להוראות הפתיחה באש ולכללי הפעלת הכוח היא נדבך מרכזי בהגנה. המפתח הוא להראות שההחלטה שהתקבלה בשבריר שנייה, בתנאי לחץ ואי-ודאות, הייתה סבירה בנסיבות שנוצרו. ניתוח מדויק של הנהלים, של זירת האירוע ושל התיעוד הוא שמבסס זאת.`,
  },
  {
    q: `מדוע ניסיון בדין המבצעי חשוב דווקא כאן?`,
    a: `אירועי שימוש בכוח נבחנים לפי מערכת כללים ייחודית - הוראות פתיחה באש, כללי הפעלת הכוח והדין המבצעי - שרק מי שמכיר אותם לעומק יכול לנתח נכון. עו"ד ליאור עייש שירת כפרקליט לעניינים מבצעיים ובתפקידי מפתח בפרקליטות הצבאית, ומכיר את התחום הזה מבפנים.`,
  },
];
---

<ServicePage
  title='חקירות מח"ש | ייצוג שוטרים ואנשי כוחות הביטחון - ליאור עייש'
  description='ייצוג בחקירות מח"ש: אירועי שימוש בכוח, ירי והוראות פתיחה באש. עו"ד ליאור עייש, לשעבר הפרקליט לעניינים מבצעיים - היכרות מעמיקה עם הדין המבצעי וכללי הפעלת הכוח.'
  path="/mahash-investigations/"
  crumbTitle='חקירות מח"ש'
  heroTitle='חקירות מח"ש'
  heroSubtitle='החלטה של שבריר שנייה בשטח נבחנת שנים לאחר מכן בחדר החקירות. ייצוג על ידי מי שמכיר את הדין המבצעי מבפנים.'
  faq={faq}
  ctaTitle='זומנתם לחקירת מח"ש?'
  ctaText="אל תיכנסו לחקירה לבד. פנו אלינו לייעוץ מוקדם - דיסקרטי, מקצועי וללא התחייבות."
>
  <p>
    <strong>חקירת מח"ש</strong> - חקירה של המחלקה לחקירות שוטרים - היא הליך
    פלילי שנפתח כאשר עולה חשד לעבירה שביצע שוטר או איש כוחות הביטחון במהלך
    תפקידו, ובמרכזה לעיתים קרובות אירועי שימוש בכוח וירי. מי שפעל בשטח בתנאי
    לחץ ואי-ודאות מוצא את עצמו נדרש להסביר, שנים לאחר מכן ובחדר סגור, החלטה
    שהתקבלה בשבריר שנייה. אנחנו מלווים שוטרים ואנשי כוחות הביטחון בהליכים
    אלה - מתוך היכרות עמוקה עם הדין המבצעי וכללי הפעלת הכוח.
  </p>

  <h2>מי נחקר על ידי מח"ש?</h2>
  <ul>
    <li>שוטרים ואנשי משטרת ישראל בכל הדרגות</li>
    <li>לוחמי משמר הגבול (מג"ב), לרבות בפעילות באזור יהודה ושומרון</li>
    <li>אנשי כוחות ביטחון נוספים המעורבים באירועי שימוש בכוח</li>
    <li>מי שמעורב באירוע ירי, מעצר או שימוש בכוח שהוגשה בגינו תלונה</li>
  </ul>

  <h2>אירועי ירי ושימוש בכוח - הוראות הפתיחה באש</h2>
  <p>
    הלב של חקירות רבות במח"ש הוא השאלה אם השימוש בכוח היה מוצדק. התשובה אינה
    נמדדת בדיעבד ובראייה שקטה, אלא לפי מה שהיה ידוע וסביר בזמן האירוע עצמו -
    בהתאם ל<strong>הוראות הפתיחה באש</strong> ולכללי הפעלת הכוח החלים על
    האירוע. ניתוח נכון דורש הבנה של הנהלים, של המרחב שבו התרחש האירוע
    (ובפרט באזור יהודה ושומרון), ושל אילוצי השטח שבהם התקבלה ההחלטה. זו בדיוק
    נקודת החוזק שלנו.
  </p>

  <h2>מה עומד על הכף?</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>מישור</th>
          <th>ההשלכה</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>פלילי</td>
          <td>כתב אישום ועונש בגין שימוש בכוח שלא כדין</td>
        </tr>
        <tr>
          <td>משמעתי ופיקודי</td>
          <td>השעיה, פגיעה בדרגה ובקריירה</td>
        </tr>
        <tr>
          <td>אישי ומקצועי</td>
          <td>פגיעה בשם הטוב ובהמשך העיסוק בתפקיד</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>איך אנחנו מלווים אתכם?</h2>
  <ul>
    <li><strong>ייעוץ לפני החקירה</strong> - הכנה, הבנת הזכויות וגיבוש אופן הצגת הדברים.</li>
    <li><strong>ניתוח מבצעי-משפטי</strong> - בחינת האירוע מול הנהלים והוראות הפתיחה באש.</li>
    <li><strong>ליווי צמוד בחקירה</strong> ובכל שלב מול מח"ש והפרקליטות.</li>
    <li><strong>ייצוג בשימוע ובמשפט</strong> - אם וכאשר מתגבש כתב אישום.</li>
  </ul>

  <h2>למה אנחנו</h2>
  <p>
    <strong>עו"ד ליאור עייש</strong> שירת בדרגת סגן אלוף בתפקידי מפתח בפרקליטות
    הצבאית, ובהם <strong>הפרקליט לעניינים מבצעיים</strong> - התפקיד שעוסק בליבה
    של אירועי שימוש בכוח, הוראות פתיחה באש והדין המבצעי. ההיכרות מבפנים עם
    האופן שבו נבחנים אירועים אלה מאפשרת לנו לבנות הגנה שמדברת בשפה של הגורמים
    החוקרים - ומציגה את האמת של מי שהיה בשטח.
  </p>
  <p>
    להיבטים נוספים של הדין הצבאי והביטחוני ראו את עמוד
    <a href="/military-law/">דיני צבא וביטחון</a>, או
    <a href="/contact/">פנו אלינו</a> לייעוץ דיסקרטי.
  </p>
</ServicePage>
