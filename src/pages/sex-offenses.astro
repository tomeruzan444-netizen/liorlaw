---
import ServicePage from "../layouts/ServicePage.astro";

const faq = [
  {
    q: `זומנתי לחקירה בחשד לעבירת מין. מה הדבר הראשון שעליי לעשות?`,
    a: `להתייעץ עם עורך דין לפני החקירה - עוד לפני שאתם אומרים מילה אחת. בתיקי מין, החקירה היא לב התיק: הגרסה שנמסרת בה, מה שנאמר ומה שלא נאמר, מלווים אתכם עד ההכרעה. לכל נחקר יש זכות להיוועץ בעורך דין, ובתחום רגיש זה מימושה עשוי להיות ההחלטה החשובה ביותר בתיק.`,
  },
  {
    q: `האם שמי יתפרסם?`,
    a: `אנחנו פועלים לשמירה מרבית על פרטיותכם, לרבות בקשות לצו איסור פרסום כשנדרש. בתיקי מין המוניטין והשם הטוב נפגעים לעיתים עוד לפני הכרעה כלשהי, ולכן הדיסקרטיות היא חלק בלתי נפרד מההגנה. כל פנייה מטופלת בחשאיות מוחלטת.`,
  },
  {
    q: `מהי הטרדה מינית מבחינה משפטית?`,
    a: `החוק למניעת הטרדה מינית מגדיר שורה של התנהגויות אסורות - החל מהצעות והתייחסויות חוזרות בעלות אופי מיני, דרך ניצול יחסי מרות, ועד פרסום תצלום או סרטון בעלי אופי מיני. הטרדה מינית עשויה להתברר במישור הפלילי, במישור האזרחי (תביעת פיצויים) ובמישור המשמעתי - לעיתים בכל שלושתם במקביל. לכל מישור כללים ואסטרטגיה משלו.`,
  },
  {
    q: `האם תלונת שווא יכולה להסתיים בזיכוי?`,
    a: `כן. חלק מהתיקים מבוססים על גרסה יחידה, על סתירות או על מניעים זרים, וניתן להפריך אותם באמצעות ניתוח מדוקדק של הראיות, איתור סתירות בגרסה, תכתובות, עדויות וחוות דעת. הגנה יסודית שנבנית מהשלב הראשון היא שמאפשרת לחשוף את האמת.`,
  },
];
---

<ServicePage
  title="עורך דין עבירות מין | ייצוג רגיש ודיסקרטי בתיקי מין חמורים - ליאור עייש"
  description="ייצוג בעבירות מין חמורות ובעבירות לפי החוק למניעת הטרדה מינית: מהחקירה ועד ההכרעה, בדיסקרטיות מלאה. ליווי מקצועי ורגיש על ידי עורך דין פלילי בכיר."
  path="/sex-offenses/"
  crumbTitle="עבירות מין חמורות"
  heroTitle="עבירות מין חמורות"
  heroSubtitle="תחום רגיש שבו המוניטין, החירות והעתיד על הכף. ייצוג מקצועי, נחוש ודיסקרטי - מהרגע הראשון."
  faq={faq}
  ctaTitle="נחקרתם או הוזמנתם לחקירה בעבירת מין?"
  ctaText="אל תדברו עם איש לפני שדיברתם איתנו. שיחת ייעוץ ראשונית - דיסקרטית לחלוטין וללא התחייבות."
>
  <p>
    <strong>עבירות מין</strong> הן מהתיקים הרגישים והמורכבים ביותר במשפט
    הפלילי: הן נבחנות פעמים רבות על בסיס גרסאות סותרות, הן טעונות רגשית, ועצם
    קיומה של חקירה עלול לפגוע במוניטין ובחיים עוד בטרם נאמרה מילה בבית המשפט.
    אנחנו מלווים נחקרים ונאשמים בתיקים אלה במקצועיות, ברגישות ובדיסקרטיות
    מוחלטת - משלב החקירה ועד ההכרעה.
  </p>

  <h2>אילו תיקים אנחנו מייצגים?</h2>
  <ul>
    <li><strong>עבירות מין חמורות</strong> - אונס, מעשה סדום, בעילה אסורה ומעשים מגונים.</li>
    <li><strong>עבירות מין במשפחה ובידי מי שאחראי על קטין או חסר ישע.</strong></li>
    <li><strong>עבירות על החוק למניעת הטרדה מינית</strong> - במישור הפלילי, האזרחי והמשמעתי.</li>
    <li><strong>עבירות מין ברשת</strong> - פרסום תוכן אינטימי, הטרדה מקוונת ועבירות הקשורות לקטינים.</li>
    <li><strong>ניצול יחסי מרות</strong> - במקום העבודה, במסגרות טיפול ובמסגרות חינוך.</li>
  </ul>

  <h2>החוק למניעת הטרדה מינית - שלושה מישורים במקביל</h2>
  <p>
    הטרדה מינית אינה עניין פלילי בלבד. אותו אירוע עשוי להתברר בו-זמנית בשלושה
    מישורים נפרדים, ולכל אחד מהם השלכות משלו:
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>מישור</th>
          <th>הגורם הדן</th>
          <th>מה על הכף</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>פלילי</td>
          <td>המשטרה והפרקליטות</td>
          <td>כתב אישום, עונש ורישום פלילי</td>
        </tr>
        <tr>
          <td>אזרחי</td>
          <td>בית הדין לעבודה או בית משפט אזרחי</td>
          <td>תביעת פיצויים כספית</td>
        </tr>
        <tr>
          <td>משמעתי</td>
          <td>ועדת משמעת במקום העבודה</td>
          <td>פיטורים, השעיה ופגיעה בקריירה</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    טיפול נכון דורש ראייה כוללת של כל המישורים יחד - כדי שמהלך במישור אחד לא
    יפגע בהגנה במישור אחר.
  </p>

  <h2>דיסקרטיות כחלק מההגנה</h2>
  <p>
    בתיקי מין, השם הטוב הוא נכס שאי אפשר להשיב. אנחנו פועלים בחשאיות מוחלטת,
    כולל טיפול בבקשות לצו איסור פרסום כשנדרש, ושומרים על התנהלות שקטה ומבוקרת
    לאורך כל ההליך. הדיסקרטיות אינה תוספת - היא חלק מהותי מאסטרטגיית ההגנה.
  </p>

  <h2>למה זה חשוב מי מייצג אתכם</h2>
  <p>
    <strong>עו"ד ליאור עייש</strong> ניהל וליווה תיקים חמורים משני צידי המתרס -
    כתובע בכיר בדרגת סגן אלוף וכסנגור. ההיכרות עם האופן שבו נבנה תיק מין
    מאפשרת לנו לזהות את נקודות התורפה שלו: סתירות בגרסה, פערים בראיות ומקומות
    שבהם התביעה חשופה. אנחנו מלווים אתכם בקצב שלכם, מסבירים כל שלב, ונאבקים
    עבורכם בנחישות תוך שמירה על כבודכם ופרטיותכם.
  </p>
  <p>
    למידע נוסף על אופן העבודה שלנו, קראו על
    <a href="/criminal-law/">הייצוג במשפט הפלילי</a>, או
    <a href="/contact/">פנו אלינו לשיחה דיסקרטית</a>.
  </p>
</ServicePage>
