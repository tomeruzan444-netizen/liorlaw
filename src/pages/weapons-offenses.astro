---
import ServicePage from "../layouts/ServicePage.astro";

const faq = [
  {
    q: `נתפס ברשותי נשק ללא רישיון. מה צפוי לי?`,
    a: `החזקת נשק שלא כדין היא עבירה חמורה, ובשנים האחרונות הוחמרה הענישה בגינה משמעותית, לרבות מגמה של עונשי מאסר בפועל וענישת מינימום. עם זאת, כל תיק נבחן לגופו: סוג האמצעי, הנסיבות, כשירות הראיות ואופן התפיסה - כל אלה משפיעים על התוצאה. ייעוץ מוקדם, עוד לפני החקירה, הוא קריטי.`,
  },
  {
    q: `מה ההבדל בין החזקת נשק, נשיאה וסחר בנשק?`,
    a: `החזקה מתייחסת לכך שהנשק נמצא ברשותכם; נשיאה והובלה מתייחסות לכך שנשאתם אותו על גופכם או ברכב; וסחר עוסק בקנייה, מכירה או תיווך בנשק. ככל שהעבירה נעה לכיוון הסחר והייצור, כך הענישה חמורה יותר - ולכן הסיווג המדויק של המעשה הוא אחד ממוקדי ההגנה.`,
  },
  {
    q: `יריתי באוויר באירוע משפחתי. זו עבירה?`,
    a: `כן. ירי באזור מגורים או ירי לאוויר הם עבירות שהמדינה מתייחסת אליהן בחומרה גוברת והולכת, גם כאשר לא נפגע איש. אנחנו בוחנים את הנסיבות, את הראיות ואת סיווג האירוע, ופועלים למזעור התוצאה הפלילית.`,
  },
  {
    q: `למה הרקע הצבאי של עורך הדין רלוונטי בתיקי נשק?`,
    a: `היכרות מעמיקה עם אמצעי לחימה, עם סוגי נשק ועם כללי השימוש בהם היא יתרון ממשי בתיקי נשק - הן בהבנת הראיות הטכניות והן בחקירת מומחי התביעה. עו"ד ליאור עייש שירת שנים בכירות במערכת הצבאית, לרבות כפרקליט לעניינים מבצעיים, ומכיר את התחום מקרוב.`,
  },
];
---

<ServicePage
  title="עורך דין עבירות נשק | החזקה, נשיאה, סחר וירי - ליאור עייש"
  description="ייצוג בעבירות נשק: החזקה ונשיאה שלא כדין, סחר וייצור, ירי באזור מגורים. בעידן של החמרת ענישה ועונשי מינימום - ליווי משפטי מקצועי מהחקירה ועד ההכרעה."
  path="/weapons-offenses/"
  crumbTitle="עבירות בנשק"
  heroTitle="עבירות בנשק"
  heroSubtitle="בעידן של החמרת ענישה ועונשי מינימום, כל תיק נשק דורש הגנה מדויקת - מהרגע שנתפס האמצעי."
  faq={faq}
  ctaTitle="נחקרתם בעבירת נשק?"
  ctaText="הענישה בתחום זה הוחמרה מאוד - אל תתמודדו לבד. פנו אלינו לייעוץ ראשוני וללא התחייבות."
>
  <p>
    <strong>עבירות נשק</strong> הן מהתחומים שהמדינה מרכזת בהם מאמצי אכיפה
    מוגברים, והענישה בגינן הוחמרה מאוד בשנים האחרונות - עד כדי עונשי מאסר
    בפועל וענישת מינימום גם בעבירות שבעבר הסתיימו אחרת. אנחנו מלווים נחקרים
    ונאשמים בכל מנעד עבירות הנשק, ובונים הגנה מדויקת שמתחילה כבר בשלב החקירה.
  </p>

  <h2>אילו עבירות נשק אנחנו מייצגים?</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>סוג העבירה</th>
          <th>במה מדובר</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>החזקת נשק שלא כדין</td>
          <td>החזקת נשק חם, חלקים או תחמושת ללא רישיון כדין</td>
        </tr>
        <tr>
          <td>נשיאה והובלה</td>
          <td>נשיאת נשק על הגוף או הובלתו ברכב שלא כדין</td>
        </tr>
        <tr>
          <td>סחר, ייצור ותיווך</td>
          <td>קנייה, מכירה, ייצור או תיווך בנשק - העבירות החמורות ביותר בתחום</td>
        </tr>
        <tr>
          <td>ירי</td>
          <td>ירי באזור מגורים, ירי לאוויר וירי המסכן חיי אדם</td>
        </tr>
        <tr>
          <td>עבירות רישוי</td>
          <td>הפרת תנאי רישיון נשק, אחסון לקוי ואי-חידוש כדין</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>עידן של החמרת ענישה</h2>
  <p>
    המדיניות המשפטית כלפי עבירות נשק השתנתה מן הקצה אל הקצה: בתי המשפט
    מנחים להטיל מאסר בפועל גם על החזקה, והמחוקק הוסיף רכיבי ענישת מינימום.
    המשמעות היא שתיק שנראה "שולי" עלול להסתיים בעונש כבד - ולכן אין להקל בו
    ראש, וכל הגנה חייבת להיבנות ברצינות מלאה מהשלב הראשון.
  </p>

  <h2>על מה נבנית ההגנה?</h2>
  <ul>
    <li><strong>כשרות התפיסה והחיפוש</strong> - חיפוש שנעשה שלא כדין עשוי להוביל לפסילת הראיה המרכזית בתיק.</li>
    <li><strong>סיווג האמצעי</strong> - האם מדובר בכלל ב"נשק" כהגדרתו בחוק, ובאיזו קטגוריה.</li>
    <li><strong>שאלת ה"החזקה"</strong> - הוכחת ידיעה ושליטה של הנאשם באמצעי אינה מובנת מאליה.</li>
    <li><strong>הנסיבות האישיות</strong> - שיקולים שיכולים לצמצם את הענישה גם כאשר יש הרשעה.</li>
    <li><strong>ליווי בחקירה</strong> - התנהלות נכונה מול השאלות והזכויות בחדר החקירות.</li>
  </ul>

  <h2>הניסיון שלנו</h2>
  <p>
    <strong>עו"ד ליאור עייש</strong> מביא לתיקי הנשק שילוב נדיר: ניסיון כתובע
    בכיר וכסנגור בדרגת סגן אלוף, לצד היכרות מעמיקה עם אמצעי לחימה ועם התחום
    המבצעי מתקופת שירותו כפרקליט לעניינים מבצעיים. ההבנה הטכנית של הראיות,
    יחד עם ההיכרות עם אופן העבודה של התביעה, מאפשרת לנו לבנות הגנה חדה
    ומבוססת.
  </p>
